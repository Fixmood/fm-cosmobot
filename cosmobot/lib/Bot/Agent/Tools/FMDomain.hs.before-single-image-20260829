          response <- HTTP.runReq $
            req GET (http "172.20.0.4" /: "library" /: "search") NoReqBody jsonResponse
              ("q" =: query <> "limit" =: limit <> port 8077)
          pure . toolText . jsonText $ (responseBody response :: [Aeson.Value])

