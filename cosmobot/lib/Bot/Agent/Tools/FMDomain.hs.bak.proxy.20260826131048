fmRepeatControlTool :: HTTP.HTTP :> es => Tool (Eff es)
fmRepeatControlTool =
  allowWhen superuserOnly
  . withDescription "View, enable, or disable FM's follow-up repetition behavior for a QQ group. Use natural owner requests instead of requiring fixed 复读开/关 commands."
  $ tool "fm_repeat_control"
      ( requiredText "action" "One of: status, enable, disable."
      , optionalText "group_id" "Optional QQ group ID; defaults to the current QQ group."
      )
      \action requestedGroup -> do
        context <- askToolContext
        case resolveQQGroup context requestedGroup of
          Nothing -> pure (toolText "请指定 QQ 群号；在 QQ 群内调用时可以省略。")
          Just groupId -> do
            let normalized = Text.toLower (Text.strip action)
            case normalized of
              "status" -> do
                response <- HTTP.runReq $
                  req GET (http "fm-domain" /: "repeat-follow" /: "state") NoReqBody jsonResponse
                    ("group_id" =: groupId <> port 8077)
                pure . toolText . jsonText $ (responseBody response :: Aeson.Value)
              "enable" -> setRepeatState groupId True
              "disable" -> setRepeatState groupId False
              _ -> pure (toolText "action 必须是 status、enable 或 disable。")

