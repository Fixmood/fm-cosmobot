        <$> o Aeson..: "status"
        <*> o Aeson..:? "kind" Aeson..!= ""
        <*> o Aeson..:? "group_id" Aeson..!= ""
        <*> o Aeson..:? "date" Aeson..!= ""
        <*> o Aeson..:? "page_count" Aeson..!= 0
        <*> o Aeson..:? "message" Aeson..!= ""
