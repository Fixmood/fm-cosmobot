resolveQQGroup :: Context -> Maybe Text -> Maybe Text
resolveQQGroup context requested =
  clean requested <|> case context.message of
    IncomingMessage{platform = PlatformQQ, kind = ChatGroup, chatId = Just groupId} -> Just (show groupId)
    _ -> Nothing
  where
    clean = (>>= \value -> let stripped = Text.strip value in stripped <$ guard (not (Text.null stripped)))

