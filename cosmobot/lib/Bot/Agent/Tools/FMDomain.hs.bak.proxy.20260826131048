  withDescription "Start FM single-character typing practice from natural language. Supported sets include 前1500, 前500, 中500, 后500, 黄500, 玄500, 地500, 天500, 王500, 皇500, 帝500. The tool sends the practice text itself; do not repeat it in the final response."
  $ tool "fm_single_practice_start"
      ( requiredText "name" "Single-character set name, such as 前500, 中500, 天500, or 帝500."
      , optionalInt "length" "Characters per segment, from 1 to 1400; default 100."
      , optionalText "order" "顺 for ordered practice or 乱 for shuffled practice; default 乱."
      , optionalText "key_requirement" "Optional minimum key-rate requirement, such as 6 or 6.5."
      , optionalText "accuracy_requirement" "Optional minimum accuracy requirement, such as 95 or 98.5."
      )
      \name requestedLength requestedOrder keyRequirement accuracyRequirement -> do
        context <- askToolContext
        withCapability context "library" do
