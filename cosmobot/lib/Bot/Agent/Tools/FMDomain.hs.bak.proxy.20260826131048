  . withDescription "View, enable, or disable FM's natural QQ poke responses for one group. This controls whether poke events reach the agent; it does not replace the automatic poke event handler."
  $ tool "fm_poke_control"
      ( requiredText "action" "One of: status, enable, disable."
      , optionalText "group_id" "Optional QQ group ID; defaults to the current QQ group."
      )
      \action requestedGroup -> do
        context <- askToolContext
        case resolveQQGroup context requestedGroup of
          Nothing -> pure (toolText "请指定 QQ 群号；在 QQ 群内调用时可以省略。")
          Just groupId -> do
